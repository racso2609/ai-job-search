# AI Job Search background service — environment.
# Copy to service/.env and fill in. Never commit the real .env.

# --- Telegram (required) -------------------------------------------------------
# 1. In Telegram, message @BotFather -> /newbot -> copy the token.
TELEGRAM_BOT_TOKEN=
# 2. Your chat id. Message @userinfobot, or send your bot a message and read
#    https://api.telegram.org/bot<TOKEN>/getUpdates -> "chat":{"id":...}
TELEGRAM_CHAT_ID=

# --- Schedule ------------------------------------------------------------------
# Cron expression for the scrape+rank+notify cycle. Default: 08:00 and 18:00.
SCRAPE_CRON=0 8,18 * * *
# Cron expression for the Gmail watch cycle. Leave blank to disable.
GMAIL_CRON=0 */3 * * *
# Timezone for the cron schedules (IANA name). Example: Europe/Madrid
TZ=UTC
# Run one cycle immediately on container start, then follow the cron.
RUN_ON_START=true

# --- Notification tuning -------------------------------------------------------
# How many top-ranked jobs to include in the Telegram summary per cycle.
TOP_N=5
# Only notify jobs with rank_score >= this (0-100). 0 = all ranked jobs.
MIN_SCORE=0
# Public URL of the dashboard, if you serve reports/ over HTTP.
# Leave blank to skip the dashboard link.
DASHBOARD_URL=

# --- Phase 2 features ----------------------------------------------------------
# Draft the application when you tap Apply (needs LaTeX for PDFs).
ENABLE_APPLY=true
# Run the Gmail watch cycle.
ENABLE_GMAIL=true
# Offer a Google Calendar event for detected interviews.
ENABLE_CALENDAR=true
# Answer free-text Telegram messages on demand (questions and reports). Turn it
# off to keep the bot tap-only.
ENABLE_SUPPORT=true

# --- Google OAuth (Gmail + Calendar MCP) ---------------------------------------
# See service/INSTALL.md section 3. Point these at the Desktop OAuth client
# JSON you download from Google Cloud, and the token files they write.
# GMAIL_CREDENTIALS_PATH=./service/secrets/gcp-oauth.keys.json
# GMAIL_OAUTH_PATH=./service/secrets/gmail-token.json
# GOOGLE_OAUTH_CREDENTIALS=./service/secrets/gcp-oauth.keys.json


# --- opencode ------------------------------------------------------------------
# Path to the opencode binary inside the container (default is fine).
OPENCODE_BIN=opencode
# Override the model, e.g. "cheaperinference/deepseek-v4.1-flash".
OPENCODE_MODEL=
# Max wall-clock ms for one opencode run (default 30 min).
OPENCODE_TIMEOUT_MS=1800000

# --- AI provider (required for opencode) ---------------------------------------
# Whatever provider your opencode config uses. Examples:
# ANTHROPIC_API_KEY=
# OPENAI_API_KEY=

# --- State ---------------------------------------------------------------------
# Where notify_state.json and decisions.jsonl live (default: service/state).
# STATE_DIR=/workspace/service/state
